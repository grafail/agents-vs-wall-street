# Copy to .env and fill in. Never commit real API keys or tokens.

# LLM access — OpenAI-compatible; provider selects which key/base URL is used
LLM_PROVIDER=openrouter          # openrouter | openai
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Models (OpenAI-compatible IDs for the chosen provider)
MODEL_BIG=                       # estimator + reconciler (pinned for the whole run — switching invalidates prompt caches)
MODEL_SMALL=                     # extraction + vibe labeling

# Pipeline config
ENABLE_RECONCILE=true
ENABLE_RESEARCH=true

# Blended USD prices per 1M tokens for run-report cost estimates (0 = unknown)
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0
OPENROUTER_PROVIDER=
